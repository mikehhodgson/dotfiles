{
  "bar": {
    "centerAnchor": "mike.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "mike.workspaces"
        }
      ],
      "center": [
        {
          "id": "mike.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake",
            "Dnd"
          ]
        },
        {
          "id": "mike.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "timeZone": "Australia/Perth",
          "calendarMode": "year",
          "weekStartDay": "sunday"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "mike.tray",
          "showAll": true,
          "pinned": [
            "KeePassXC",
            "steam"
          ],
          "hidden": []
        },
        {
          "id": "mike.gnucash",
          "interval": 5,
          "color": "#00FF00",
          "onClick": "~/.local/bin/launch-or-focus-gnucash",
          "command": "if compgen -G \"$HOME/Documents/Personal/Finance/gnucash/current/*.LCK\" >/dev/null; then printf '$'; fi"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "mike.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "mike.cpu",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "onRightClick": "alacritty",
          "tooltip": "CPU usage",
          "command": "python3 ~/.config/omarchy/bar/scripts/status.py cpu",
          "widthText": "100% 󰍛"
        },
        {
          "id": "mike.memory",
          "interval": 10,
          "tooltip": "Used / total memory",
          "command": "python3 ~/.config/omarchy/bar/scripts/status.py memory",
          "widthText": "9.9G/31G"
        },
        {
          "id": "mike.power",
          "showPercentage": true,
          "compactWidthText": "100% ",
          "expandedWidthText": "T-9:99↓ 9.9W↓ 100% 󰁹"
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "omarchy.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "mike.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.monitor"
  ],
  "cloneSourceRestores": [
    "mike.lock"
  ]
}
